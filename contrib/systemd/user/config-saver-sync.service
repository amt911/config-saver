[Unit]
Description=Config Saver: multi-machine sync (pull, merge, push)
Documentation=man:systemd.service(5)
# A failed run (conflict: exit 11, git/network: exit 10, not set up: exit 2)
# raises a desktop notification through the freedesktop notification service.
OnFailure=config-saver-notify@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h
Environment=PYTHONUNBUFFERED=1
# The sync repository holds secrets: keep every file the run creates private.
UMask=0077
ExecStart=/usr/bin/env python3 -m config_saver --sync

# No [Install]: this service is started by config-saver-sync.timer.
