[Unit]
Description=Config Saver: compress the current user's configurations
Documentation=man:systemd.service(5)
After=network.target

[Service]
Type=oneshot
# A user unit already runs as the right user with the right HOME: setting User=
# here is illegal, and overriding HOME would only break it.
WorkingDirectory=%h
Environment=PYTHONUNBUFFERED=1
# Archives contain secrets: keep every file the run creates private.
UMask=0077
# Prefer system python; if you need a venv use the absolute python binary below
ExecStart=/usr/bin/env python3 -m config_saver --compress --description "Automated backup by systemd timer"

[Install]
WantedBy=default.target
